{
  "name": "mis-estudios",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "predev": "npm run vendor",
    "build": "tsc && vite build",
    "prebuild": "npm run vendor",
    "preview": "vite preview",
    "start": "vite preview",
    "vendor": "node scripts/vendor.mjs",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:offline": "npm run build && playwright test --config playwright.offline.config.ts",
    "test:outbox": "playwright test --config playwright.outbox.config.ts",
    "test:lighthouse": "npm run build && lhci autorun",
    "lint": "eslint . && stylelint 'src/**/*.css'",
    "typecheck": "tsc --noEmit",
    "test:a11y": "vitest run test/a11y.test.ts",
    "docs:api": "typedoc --entryPointStrategy expand --out docs/api src/",
    "bot:build": "vite build --config vite.telegram.config.ts",
    "bot": "node --env-file-if-exists=.env.telegram .data/telegram-build/telegram.mjs"
  },
  "dependencies": {
    "@preact/signals": "^2.0.0",
    "@tanstack/virtual-core": "^3.19.11",
    "@tesseract.js-data/spa": "1.0.0",
    "comlink": "^4.4.2",
    "jszip": "^3.10.2",
    "pdfjs-dist": "6.5.438",
    "preact": "^11.2.0",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/eslint-plugin": "^8.73.0",
    "@typescript-eslint/parser": "^8.73.0",
    "@vitest/coverage-v8": "^5.1.1",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "fake-indexeddb": "^6.2.8",
    "idb": "^8.0.4",
    "jsdom": "^31.0.1",
    "msw": "^3.0.7",
    "prettier": "^3.10.1",
    "stylelint": "^18.1.0",
    "stylelint-config-standard": "^41.1.0",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.14.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
